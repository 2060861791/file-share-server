# ─────────────────────────────────────────────────────────────
#  文件共享服务器 — 配置示例
#  复制本文件为 .env 后按需修改。系统环境变量优先级高于 .env。
# ─────────────────────────────────────────────────────────────

# ── 共享目录（用户上传的文件都放这里，与项目代码分离）──
# 按系统保留一行，删掉行首的 #；其余行保持注释。
# 不设置时默认使用 /srv/file-share/files（仅适合 Linux）。

# Linux / macOS
# SHARE_DIR=/srv/file-share/files

# Windows（推荐用正斜杠，或写成双反斜杠）
# SHARE_DIR=D:/file-share/files
# SHARE_DIR=D:\\file-share\\files

# ── 服务端口 ──
PORT=8420

# ── 单文件上传上限（字节），0 = 不限制 ──
# 例如 4GB: 4294967296
MAX_UPLOAD_BYTES=0
